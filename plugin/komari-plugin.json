{
  "name": {
    "zh_CN": "代理中枢",
    "en": "Proxy Hub"
  },
  "short": "proxy-hub",
  "description": {
    "zh_CN": "节点、订阅、分流规则与流量统计的一体化管理中枢。支持多节点聚合、Clash API / Xray access log 统计、节点创建、长短链订阅和策略组可视化编辑。",
    "en": "A unified hub for proxy nodes, subscriptions, routing rules, and traffic analytics, with multi-node aggregation, node provisioning, share links, and a visual policy editor."
  },
  "author": "Syngnat",
  "version": "2.3.0",
  "url": "https://github.com/Syngnat/komari-proxy-hub",
  "komari": ">=1.6.0",
  "entry": "script.js",
  "permissions": {
    "allowRoutes": true,
    "allowSystemRPC": true,
    "timeout": 30,
    "maxHTTPBodyBytes": 2097152
  },
  "pages": [
    {
      "file": "pages/traffic.html",
      "title": {
        "zh_CN": "流量排行",
        "en": "Traffic Ranking"
      },
      "type": "iframe",
      "visibility": "admin"
    },
    {
      "file": "pages/provision.html",
      "title": {
        "zh_CN": "创建代理节点",
        "en": "Create proxy node"
      },
      "type": "iframe",
      "visibility": "admin"
    },
    {
      "file": "pages/subscriptions.html",
      "title": {
        "zh_CN": "订阅管理",
        "en": "Subscriptions"
      },
      "type": "iframe",
      "visibility": "admin"
    },
    {
      "file": "pages/rules.html",
      "title": {
        "zh_CN": "分流规则",
        "en": "Routing rules"
      },
      "type": "iframe",
      "visibility": "admin"
    }
  ]
}
