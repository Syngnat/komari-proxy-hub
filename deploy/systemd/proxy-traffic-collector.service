[Unit]
Description=Komari proxy traffic collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=proxy-traffic
Group=proxy-traffic
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/proxy-traffic/collector.py
Restart=always
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/proxy-traffic /etc/proxy-traffic
ReadWritePaths=/var/lib/proxy-traffic
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
